# Copy to deploy/remote.env (git-ignored) and fill in. Only what the remote container needs: no APPROVAL_SECRET, no LLM key.
REMOTE_PROFILE_ENABLED=true
# Public origin, exactly as clients reach it (https://localhost:8443 for the tls-local rehearsal)
REMOTE_BASE_URL=
# From `npm run remote:owner` / `npm run remote:client -- <redirect-uri>`. Keep the single quotes:
# Docker Compose expands $ inside unquoted env_file values, which would corrupt the scrypt hash.
REMOTE_OWNER_PASSWORD_HASH='scrypt$...'
REMOTE_OAUTH_CLIENTS='[]'
REMOTE_TRUST_PROXY=true
APP_TIMEZONE=Asia/Kolkata
# Shown on /privacy and /terms; unset values appear as highlighted placeholders
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_JURISDICTION=
LEGAL_EFFECTIVE_DATE=
