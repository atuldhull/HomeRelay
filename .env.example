# HomeRelay configuration. Copy to .env (never commit .env).

# --- Ports ---
WEB_PORT=5173
API_PORT=3000
MCP_PORT=3001

# --- Services ---
MCP_URL=http://127.0.0.1:3001/mcp
WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=.data/homerelay.db
APP_TIMEZONE=Asia/Kolkata

# --- Security (required) ---
# Shared by the API and MCP server only. Lets user-action endpoints (approve/reject/reset) call privileged tools.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APPROVAL_SECRET=

# --- Demo ---
ALLOW_DEMO_RESET=true

# --- Optional LLM mode (leave empty to run fully deterministic, no key needed) ---
LLM_PROVIDER=deterministic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Document vault ---
# Uploaded files are stored here under opaque names (default: .data/documents). Never inside the web root.
DOCUMENTS_DIR=.data/documents
# Total size of all stored files (default 2048). Uploads beyond it are refused with STORAGE_FULL.
DOCUMENT_STORAGE_MAX_MB=2048
DOCUMENT_MAX_MB=10
# Let the optional LLM agent read document text and search snippets (sent to the provider). Off by default.
LLM_DOCUMENT_ACCESS=false

# --- Remote profile (Alexa+ add-on endpoint). OFF by default; see docs/ALEXA_PLUS_INTEGRATION.md ---
# Exposes a reduced, OAuth-protected tool set at <REMOTE_BASE_URL>/mcp. Binds to 127.0.0.1; put a TLS reverse proxy in front.
REMOTE_PROFILE_ENABLED=false
# Public https origin the proxy serves (no trailing slash). The OAuth issuer and resource derive from it.
REMOTE_BASE_URL=
REMOTE_PORT=3002
# From `npm run remote:owner` (scrypt hash only; the password is never stored)
REMOTE_OWNER_PASSWORD_HASH=
# JSON array from `npm run remote:client -- <redirect-uri>` (stores only the client secret's SHA-256)
REMOTE_OAUTH_CLIENTS=[]
# Use X-Forwarded-For from a proxy on loopback or a private network (for per-client rate limits)
REMOTE_TRUST_PROXY=false
# Request log (method, path without query, status, ms; never tokens). Set to false to silence.
REMOTE_LOG_REQUESTS=true
# Add-on images served at /assets/addon/ (default assets/brand/addon)
REMOTE_ASSETS_DIR=
# Operator details shown on /privacy and /terms; unset values appear as highlighted placeholders
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_JURISDICTION=
LEGAL_EFFECTIVE_DATE=
