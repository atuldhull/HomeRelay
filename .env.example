# HomeRelay configuration. Copy to .env (never commit .env).

# --- Ports ---
WEB_PORT=5173
API_PORT=3000
MCP_PORT=3001

# --- Services ---
MCP_URL=http://127.0.0.1:3001/mcp
WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=.data/homerelay.db
APP_TIMEZONE=Asia/Kolkata

# --- Security (required) ---
# Shared by the API and MCP server only. Lets user-action endpoints (approve/reject/reset) call privileged tools.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APPROVAL_SECRET=

# --- Demo ---
ALLOW_DEMO_RESET=true

# --- Optional LLM mode (leave empty to run fully deterministic, no key needed) ---
LLM_PROVIDER=deterministic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Document vault ---
# Uploaded files are stored here under opaque names (default: .data/documents). Never inside the web root.
DOCUMENTS_DIR=.data/documents
DOCUMENT_MAX_MB=10
# Let the optional LLM agent read document text and search snippets (sent to the provider). Off by default.
LLM_DOCUMENT_ACCESS=false
